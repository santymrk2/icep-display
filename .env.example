# Copiar a .env y cambiar las contraseñas.
POSTGRES_PASSWORD=cambiar-esto
MINIO_ROOT_USER=carteleria
MINIO_ROOT_PASSWORD=cambiar-esto-tambien
# Primer administrador. Solo se usa la PRIMERA vez que arranca (cuando no hay usuarios).
# Si queda vacío, se genera una contraseña y se imprime en el log: `docker compose logs app`.
# Después se gestionan los usuarios desde el panel (Usuarios).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Zona horaria para las franjas de programación
TZ=America/Argentina/Buenos_Aires
# Reuniones desde Notion (opcional). Sirven los mismos valores que usa la página web de la
# iglesia: NOTION_TOKEN = su NOTION_API_KEY y NOTION_DATABASE_ID = su DATABASE_ID (o el link de
# la base). Nunca compartas el token por chat.
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Opcional: nombres de las propiedades. Vacíos = "Fecha" y "Tipo de Reunión", como en la web.
NOTION_DATE_PROPERTY=
NOTION_TYPE_PROPERTY=
# Cada cuántos minutos se consulta Notion y cuántos días hacia adelante se traen.
NOTION_SYNC_MINUTES=10
NOTION_DAYS_AHEAD=60
