# Copiar a .env y cambiar las contraseñas.
POSTGRES_PASSWORD=cambiar-esto
MINIO_ROOT_USER=carteleria
MINIO_ROOT_PASSWORD=cambiar-esto-tambien
# Primer administrador. Solo se usa la PRIMERA vez que arranca (cuando no hay usuarios).
# Si queda vacío, se genera una contraseña y se imprime en el log: `docker compose logs app`.
# Después se gestionan los usuarios desde el panel (Usuarios).
ADMIN_USER=admin
ADMIN_PASSWORD=
# Zona horaria para las franjas de programación
TZ=America/Argentina/Buenos_Aires
